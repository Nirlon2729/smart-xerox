# Backend API Base URL
# For local laptop testing: http://localhost:5000/api
# For Render deployment: https://your-render-backend.onrender.com/api
BACKEND_API_URL=http://localhost:5000/api

# Must match PRINT_AGENT_TOKEN in backend/.env
PRINT_AGENT_TOKEN=replace_with_a_long_random_agent_token

# Unique identifier for this Windows 11 laptop
AGENT_DEVICE_ID=win11-hp-m129-m134-usb

# Exact Windows Printer Name
PRINTER_NAME=HP LaserJet MFP M129-M134

# Polling interval in seconds
POLL_INTERVAL_SECONDS=3
