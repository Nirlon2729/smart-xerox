PORT=5000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/smart-xerox
JWT_SECRET=replace_with_a_long_random_secret
PRINT_AGENT_TOKEN=replace_with_a_long_random_agent_token
PRINTER_NAME=Exact Windows printer name
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change_this_before_first_run
