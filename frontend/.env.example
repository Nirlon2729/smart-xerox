# API Base URL
# For local mobile testing over Wi-Fi LAN, use your laptop's LAN IPv4 address:
# Example: VITE_API_BASE_URL=http://192.168.0.105:5000/api
# For Render production deployment, set your Render Web Service HTTPS URL:
# Example: VITE_API_BASE_URL=https://smart-xerox-api.onrender.com/api
VITE_API_BASE_URL=http://192.168.0.105:5000/api

# Upload & Print Limits
VITE_MAX_UPLOAD_MB=20
VITE_MAX_COPIES=100
